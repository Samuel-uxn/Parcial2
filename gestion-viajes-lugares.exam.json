    {
      "id": "TRIP-MVVM-001",
      "type": "technical",
      "title": "Separación de responsabilidades mediante MVVM",
      "description": "La solución separa la interfaz, el estado de presentación y la lógica de negocio mediante responsabilidades compatibles con MVVM. La lógica de validación y las operaciones de viajes y lugares no deben estar implementadas exclusivamente dentro de los componentes visuales.",
      "weight": 0.0,
      "source": {
        "file": "criterio_arquitectura_android",
        "section": "Rúbrica global unified-android:v1",
        "reference": "D4. Arquitectura"
      },
      "acceptance_criteria": [
        {
          "id": "TRIP-MVVM-001-AC1",
          "description": "Se identifican responsabilidades diferenciadas para interfaz (View), ViewModel y modelo/dominio.",
          "verification": [
            "source_inspection",
            "static_analysis"
          ],
          "evidence_hints": [
            "Screen",
            "ViewModel",
            "Model",
            "Repository",
            "UseCase"
          ]
        },
        {
          "id": "TRIP-MVVM-001-AC2",
          "description": "La ViewModel no mantiene referencias a componentes visuales ni contiene funciones Composable.",
          "verification": [
            "source_inspection",
            "static_analysis"
          ],
          "evidence_hints": [
            "ViewModel",
            "android.view",
            "Activity",
            "@Composable"
          ]
        },
        {
          "id": "TRIP-MVVM-001-AC3",
          "description": "Las reglas de validación de fechas y las operaciones principales pueden probarse sin ejecutar la interfaz gráfica.",
          "verification": [
            "source_inspection",
            "unit_test"
          ],
          "evidence_hints": [
            "domain",
            "TripValidator",
            "PlaceValidator",
            "UseCase"
          ]
        }
      ],
      "related_requirements": [
